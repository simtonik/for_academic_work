package org.example;

public class Main1 {

    public static long a(int n) {

        if (n == 0) {
            return 1;
        }
        if (n == 1) {
            return 2;
        }

        return 3 * a(n - 1) - a(n - 2);
    }

    public static void main(String[] args) {

        for (int i = 0; i <= 4; i++) {
            System.out.println("a(" + i + ") = " + a(i));
        }
    }
}
